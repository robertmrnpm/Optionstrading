# Copy to .env and fill in. Never commit .env.

# --- Webull OpenAPI (https://developer.webull.com) -----------------------------------------
# Apply for OpenAPI access in the Webull app / developer portal, create an application,
# and copy its App Key + App Secret here. On first connection, approve the login request
# in your Webull mobile app (the token is cached in data/webull_token/).
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Optional: pick a specific account (otherwise the first account on the key is used).
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us

# Letting the agents place REAL orders on their own (trade_mode=auto in live mode) needs this
# explicit second opt-in. Leave it false until you have weeks of paper results you trust.
ALLOW_LIVE_AUTO_TRADING=false

# --- Dashboard ----------------------------------------------------------------------------------
# Required if you bind to anything other than localhost (e.g. to use it from your phone).
DASHBOARD_TOKEN=
# Link included in phone notifications, e.g. https://my-box.tailnet.ts.net:8000
DASHBOARD_PUBLIC_URL=

# --- AI analyst agent (optional) ------------------------------------------------------------------
# Enables a Claude-powered second opinion (with web search for news/catalysts) on every proposal.
# Also set ai.enabled: true in config.yaml.
ANTHROPIC_API_KEY=

# --- Phone notifications (any/all optional) --------------------------------------------------------
# ntfy: install the ntfy app, subscribe to a long random topic name, put it here.
NTFY_TOPIC=
# Discord: channel settings -> Integrations -> Webhooks -> copy URL
DISCORD_WEBHOOK_URL=
# Telegram: create a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
